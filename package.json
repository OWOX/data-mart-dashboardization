{
  "name": "data-mart-dashboards",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run css && vite",
    "build": "npm run verify:sdk && vite build",
    "verify:sdk": "node scripts/verify-plugin-sdk.mjs",
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i ui/styles.src.css -o ui/styles.css --minify",
    "css:check": "tailwindcss -i ui/styles.src.css -o /tmp/dmd-styles-check.css --minify && diff -q /tmp/dmd-styles-check.css ui/styles.css || (echo '\n✗ ui/styles.css is STALE. The host serves only this precompiled file, so any Tailwind class missing from it renders unstyled. Run: npm run css — and commit the result.\n' && exit 1)"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "0.28.1",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.0",
    "vite": "8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@owox/plugin-sdk": "0.32.0-next-20260810110450",
    "clsx": "^2.1.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.0"
  }
}
