{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    // The mock mirrors the SDK's current plugin/collections contract and keeps local development
    // independent of a host iframe. Production builds resolve the installed package in Vite.
    "paths": { "@owox/plugin-sdk": ["./ui/sdk-mock"] }
  },
  "include": ["ui", "src"]
}
